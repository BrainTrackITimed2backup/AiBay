# AiBay environment template
# Copy this file to `.env` for local development.
# Never commit real credentials.

# --------------------
# Core runtime
# --------------------
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-a-long-random-secret

# Optional (used by Vite config in Replit environments)
REPL_ID=

# --------------------
# Database (Neon/Postgres)
# --------------------
# Required by Drizzle/server. `NEON_DATABASE_URL` is preferred in server/db.ts.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
NEON_DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# --------------------
# Frontend build/runtime
# --------------------
VITE_BASE_PATH=/
VITE_API_URL=
# Used in admin page fallback auth gate.
VITE_ADMIN_PASSWORD=replace-with-admin-password

# --------------------
# External integrations
# --------------------
EBAY_APP_ID=
REPLICATE_API_TOKEN=
